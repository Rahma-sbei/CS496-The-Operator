# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini


# ---- LangSmith (tracing + eval datasets) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=gmail-operator

# ---- Backend security ----
# Any long random string. Paste the same value into the extension settings.
API_TOKEN=change-me-to-a-long-random-string

# ---- Stop rule / safety caps (enforced in code) ----
MAX_STEPS=15
MAX_WRITES=15
MAX_TOKENS=60000

# ---- Cost model (USD per 1M tokens; edit to match your model's pricing) ----
PRICE_IN_PER_1M=0.40
PRICE_OUT_PER_1M=1.60
